    def get_memory_context_for_prompt(self) -> str:
        """
        Formats all learned user preferences from rescued photos
        into a concise few-shot memory context to inject into the vision model prompt.
        """
        memory = self._load_json(self.memory_file)
        rescued = memory.get("rescued_memories", [])
        if not rescued:
            return ""
        context_lines = [
            "\n### USER'S PERSONAL TASTE & MEMORY (Learned from photos the user rescued from To_Review_Trash):",
            "The user previously retrieved the following photos from the trash because they value them. DO NOT mark photos with similar subjects or context as Trash:"
        ]
        # Use recent rescues (up to 10) to keep prompt focused
        for idx, entry in enumerate(rescued[-10:], 1):
            desc = entry.get("description", "No description")
            insight = entry.get("learned_insight", "")
            context_lines.append(f"{idx}. {desc} -> {insight}")
        context_lines.append(
            "Adapt your 'value' score and 'Keep'/'Trash' categorization to honor these user preferences.\n"
        )
        return "\n".join(context_lines)
    def get_stats(self) -> Dict[str, Any]:
        state = self._load_json(self.state_file)
        memory = self._load_json(self.memory_file)
        processed = state.get("processed_photos", {})
        trash = state.get("trash_registry", {})
        rescued = memory.get("rescued_memories", [])
        kept_count = sum(1 for p in processed.values() if p.get("status") == "kept")
        in_trash_count = sum(1 for p in trash.values() if p.get("status") == "in_trash")
        rescued_count = len(rescued)
        return {
            "total_processed": len(processed),
            "kept": kept_count,
            "in_trash": in_trash_count,
            "rescued_by_user": rescued_count,
            "recent_rescues": rescued[-5:]
        }

    
    
